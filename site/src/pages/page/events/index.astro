---
import { IMAGE_FORMAT } from "@hina-is/bestdori/constants";

import { isEqual, upperFirst } from "es-toolkit";

import IconLoader from "~/components/loader/icon-loader.astro";
import InfiniteLoader from "~/components/loader/infinite-loader.astro";
import Icon from "~/components/shared/icon.astro";
import BaseLayout from "~/layouts/base-layout.astro";
import { pages } from "~/lib/page";
import { paginate } from "~/lib/paginate";
import EventCard from "./_event-card.astro";
import { filterEvents, getEvents } from "./_list";
import { schema } from "./_params";

const params = Astro.locals.parseQuery(schema);

const events = getEvents(params);
const lastEvent = events.available.at(0) ?? events.list[0];
const { filtered } = await filterEvents(params, events.list);
const page = paginate({
	items: filtered,
	context: Astro,
	size: 6,
	extraProps: { "hx-select": "#events .event-card", "hx-swap": "afterend" },
	params,
});

if (Astro.request.headers.get("hx-request") === "true" && page.current === 1) {
	const isDefault = isEqual(params, schema.parse({}));

	const replaceUrl = new URL(Astro.url);
	replaceUrl.search = isDefault ? "" : Astro.url.search;
	replaceUrl.searchParams.delete("page");
	Astro.response.headers.set("hx-replace-url", replaceUrl.href);
}
---

<BaseLayout
	background={events.available.length > 0
		? {
				...Astro.locals.useThumbhash(`${events.available[0].slug}-background`),
				src: `/assets/events/${events.available[0].slug}-background.${IMAGE_FORMAT}`,
				alt: `${events.available[0].name} background`,
			}
		: undefined}
	metadata={pages["/page/events"]}
>
	<div class="flex flex-col gap-8">
		<div class="flex flex-col items-center gap-4" id="available-events">
			<h2 class="badge w-48 badge-xl font-medium badge-primary">
				Available events
			</h2>

			<div class="flex flex-wrap justify-center gap-x-2 gap-y-4">
				{
					events.available.length > 0 ? (
						events.available.map((event) => <EventCard {event} />)
					) : (
						<p class="text-base-content/50">
							No available event at the moment.
						</p>
					)
				}
			</div>
		</div>

		<div class="flex scroll-mt-8 flex-col items-center gap-4" id="events">
			<div class="inline-flex gap-2">
				<button
					hx-get="/page/events/filter"
					class="tooltip btn tooltip-bottom tooltip-start btn-circle btn-secondary btn-sm"
					data-tip={`Filter events`}
					data-umami-event="filter-events"
					hx-vals={JSON.stringify(params)}
				>
					<IconLoader name="lucide--list-filter" />
				</button>

				<h2 class="badge w-48 badge-xl font-medium badge-primary">
					{upperFirst(params.list)} events
				</h2>

				<button
					class="tooltip btn tooltip-bottom tooltip-end btn-circle btn-secondary btn-sm"
					data-tip="Show events"
					popovertarget="choose-show-events"
					style="anchor-name: --anchor-choose-show-events"
				>
					<Icon name="lucide--clock" />
				</button>
				<div
					class="dropdown dropdown-end mt-1 w-max overflow-hidden rounded-field bg-base-100/80 shadow-sm"
					id="choose-show-events"
					hx-select="#events"
					hx-swap="outerHTML transition:true"
					hx-target="#events"
					popover
					style="position-anchor: --anchor-choose-show-events"
				>
					<div class="join join-vertical">
						<button
							hx-get={Astro.url.pathname}
							name="list"
							data-umami-event="switch-event-list"
							data-umami-event-show="future"
							value="future"
							class:list={[
								"btn join-item btn-sm",
								params.list === "future" &&
									"pointer-events-none btn-active btn-secondary",
							]}
						>
							<IconLoader name="lucide--calendar-clock" />
							Future
						</button>
						<button
							hx-get={Astro.url.pathname}
							name="list"
							data-umami-event="switch-event-list"
							data-umami-event-show="past"
							value="past"
							class:list={[
								"btn join-item btn-sm",
								params.list === "past" &&
									"pointer-events-none btn-active btn-secondary",
							]}
						>
							<IconLoader name="lucide--history" />
							Past
						</button>
					</div>
				</div>
			</div>

			<div
				class="flex flex-wrap justify-center gap-x-2 gap-y-4"
				hx-indicator="#events-loader"
			>
				{
					page.items.map((event, idx) => (
						<EventCard
							{...(page.isLastElement(idx) && page.props)}
							{event}
							predicted={params.list === "future"}
							priorEvents={
								params.list === "future"
									? Number(event.id) - Number(lastEvent.id)
									: undefined
							}
						/>
					))
				}
			</div>
		</div>

		<InfiniteLoader id="events-loader" thing="events" />
	</div>
</BaseLayout>
