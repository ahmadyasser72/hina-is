---
import { IMAGE_FORMAT } from "@hina-is/bestdori/constants";
import type { Bandori } from "@hina-is/bestdori/data";

import IconLoader from "~/components/loader/icon-loader.astro";
import Icon from "~/components/shared/icon.astro";
import { dayjs } from "~/lib/date";
import { formatEventType } from "~/lib/utilities";
import EventCardBandIcon from "./_event-card-band-icon.astro";
import EventCardCharacterIcon from "./_event-card-character-icon.astro";
import EventCardProgress from "./_event-card-progress.astro";
import EventCardTime from "./_event-card-time.astro";

interface Props {
	event: Bandori.Event;
	predicted?: boolean;
	priorEvents?: number;
}

const { event, predicted, priorEvents, ...props } = Astro.props;
const { attribute, band, characters, startAt, endAt } = event;

const progress = (() => {
	if (predicted || !startAt.en || !endAt.en) return;

	const now = dayjs();
	const start = dayjs(startAt.en);
	const end = dayjs(endAt.en);

	if (now.isBefore(end)) return { now, start, end };
})();
---

<div class="event-card flex flex-col gap-1" {...props} hx-disinherit="*">
	<div class="card w-90 flex-1 bg-base-100 shadow-sm">
		<figure>
			<img
				class="aspect-3/1 h-32"
				{...Astro.locals.useThumbhash(`${event.slug}-banner`)}
				src={`/assets/events/${event.slug}-banner.${IMAGE_FORMAT}`}
				alt={`${event.name} banner`}
				loading="lazy"
			/>
		</figure>
		<div class="card-body items-center text-center">
			<h2 class="card-title flex-1">
				{event.name}
			</h2>

			<EventCardTime {endAt} region="jp" {startAt} />

			<EventCardTime {endAt} {predicted} {priorEvents} region="en" {startAt} />

			<div class="flex flex-wrap justify-center gap-1">
				<div class="badge font-medium dark:badge-soft dark:badge-primary">
					<div
						class="tooltip tooltip-attribute"
						data-attribute={attribute.slug}
						data-tip={attribute.name}
					>
						<img
							class="size-5"
							src={`/assets/attributes/${attribute.slug}.svg`}
							alt=`${attribute.name} icon`
							loading="lazy"
						/>
					</div>

					{formatEventType(event.type)}
				</div>

				{
					Array.isArray(band) ? (
						<div class="badge dark:badge-soft dark:badge-primary">
							{band.map((band) => (
								<EventCardBandIcon {band} />
							))}
						</div>
					) : (
						<div class="badge font-medium badge-band" data-band={band.slug}>
							<img
								class="size-5"
								src={`/assets/bands/${band.slug}.svg`}
								alt={`${band.name} icon`}
								loading="lazy"
							/>

							{band.name}
						</div>
					)
				}
			</div>

			<div class="flex flex-wrap justify-center gap-1">
				{
					characters.length > 5 ? (
						<>
							{characters.slice(0, 4).map((character) => (
								<EventCardCharacterIcon
									{character}
									displayBand={Array.isArray(band)}
								/>
							))}

							<details class="dropdown dropdown-end dropdown-top z-0">
								<summary class="btn btn-circle size-10 btn-outline">
									<Icon name="lucide--chevron-up" />
								</summary>
								<div class="dropdown-content mb-2 flex w-60 flex-wrap justify-center gap-1 rounded-box bg-base-100 p-2 shadow-sm">
									{characters.slice(4).map((character) => (
										<EventCardCharacterIcon
											{character}
											displayBand={Array.isArray(band)}
										/>
									))}
								</div>
							</details>
						</>
					) : (
						characters.map((character) => (
							<EventCardCharacterIcon
								{character}
								displayBand={Array.isArray(band)}
							/>
						))
					)
				}
			</div>

			{progress && <EventCardProgress {...progress} />}
		</div>
	</div>

	<div class="flex gap-1">
		<a
			class="btn flex-1 btn-sm btn-info"
			data-umami-event="view-event-on-bestdori"
			data-umami-event-event={event.slug}
			data-umami-event-id={event.id}
			href={`https://bestdori.com/info/events/${event.id}`}
			rel="noopener noreferrer"
			target="_blank"
		>
			<Icon name="lucide--external-link" />
			View on Bestdori!
		</a>

		<button
			hx-get={`/partials/event/${event.slug}`}
			class="tooltip btn tooltip-left btn-square btn-soft btn-sm"
			data-tip="Extra details"
			data-umami-event="view-event-details"
			data-umami-event-event={event.slug}
			data-umami-event-id={event.id}
		>
			<IconLoader name="lucide--ellipsis" size- />
		</button>
	</div>
</div>
