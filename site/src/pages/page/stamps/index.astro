---
import { isEqual } from "es-toolkit";

import IconLoader from "~/components/loader/icon-loader.astro";
import InfiniteLoader from "~/components/loader/infinite-loader.astro";
import BandoriStamp from "~/components/shared/bandori-stamp.astro";
import Icon from "~/components/shared/icon.astro";
import BaseLayout from "~/layouts/base-layout.astro";
import { pages } from "~/lib/page";
import { paginate } from "~/lib/paginate";
import { filterStamps, getStamps } from "./_list";
import { schema } from "./_params";

const params = Astro.locals.parseQuery(schema);

const stamps = getStamps();
const { filtered } = await filterStamps(params, stamps);
const page = paginate({
	items: filtered,
	context: Astro,
	size: 32,
	extraProps: { "hx-select": ".stamp", "hx-swap": "afterend" },
	params,
});

if (Astro.request.headers.get("hx-request") === "true" && page.current === 1) {
	const isDefault = isEqual(params, schema.parse({}));

	const replaceUrl = new URL(Astro.url);
	replaceUrl.search = isDefault ? "" : Astro.url.search;
	replaceUrl.searchParams.delete("page");
	replaceUrl.searchParams.delete("query");
	Astro.response.headers.set("hx-replace-url", replaceUrl.href);
}
---

<BaseLayout metadata={pages["/page/stamps"]}>
	<div class="flex flex-col items-center gap-4" id="stamps">
		<div class="inline-flex gap-2">
			<button
				hx-get="/page/stamps/filter"
				class="tooltip btn tooltip-right btn-circle btn-sm btn-success"
				data-tip="Filter stamps"
				data-umami-event="filter-stamps"
				hx-vals={JSON.stringify(params)}
			>
				<IconLoader name="lucide--list-filter" />
			</button>

			<h2 class="badge w-48 badge-xl font-medium badge-accent">Stamps</h2>

			<button
				class="tooltip btn tooltip-left btn-circle btn-sm btn-success"
				data-tip="Sort stamps"
				popovertarget="choose-sort-stamps"
				style="anchor-name: --anchor-choose-sort-stamps"
			>
				<Icon name="lucide--arrow-up-down" />
			</button>
			<div
				class="dropdown dropdown-end mt-1 w-max overflow-hidden rounded-field bg-base-100/80 shadow-sm"
				id="choose-sort-stamps"
				hx-select="#stamps"
				hx-swap="outerHTML transition:true"
				hx-target="#stamps"
				popover
				style="position-anchor: --anchor-choose-sort-stamps"
			>
				<div class="join join-vertical">
					<button
						hx-get
						name="sort"
						data-umami-event="change-stamp-sort"
						data-umami-event-show="default"
						value="default"
						class:list={[
							"btn join-item btn-sm",
							params.sort === "default" &&
								"pointer-events-none btn-active btn-secondary",
						]}
					>
						<IconLoader name="lucide--list" />
						Default
					</button>
					<button
						hx-get
						name="sort"
						data-umami-event="change-stamp-sort"
						data-umami-event-show="event-release"
						value="event-release"
						class:list={[
							"btn join-item btn-sm",
							params.sort === "event-release" &&
								"pointer-events-none btn-active btn-secondary",
						]}
					>
						<IconLoader name="lucide--calendar" />
						Event release
					</button>
				</div>
			</div>
		</div>

		<label class="input w-64">
			<Icon name="lucide--search" />
			<input
				hx-get
				hx-trigger="input delay:300ms"
				class="flex-1"
				name="query"
				data-umami-event="search-stamps"
				type="search"
				hx-select="#stamp-list"
				hx-swap="outerHTML transition:true"
				hx-target="#stamp-list"
				placeholder="Search"
			/>
		</label>

		<div
			class="flex flex-wrap justify-center gap-x-0.5 gap-y-1"
			id="stamp-list"
			hx-indicator="#stamps-loader"
		>
			{
				page.items.map((stamp, idx) => (
					<BandoriStamp
						class="stamp"
						{stamp}
						{...(page.isLastElement(idx) && page.props)}
					/>
				))
			}
		</div>
	</div>

	<InfiniteLoader class="mt-8" id="stamps-loader" thing="stamps" />
</BaseLayout>
