---
import * as data from "@hina-is/bestdori/data";

import { sample, shuffle } from "es-toolkit";

import IconLoader from "~/components/loader/icon-loader.astro";
import { CharacterSorter } from "~/components/preact/character-sorter";
import {
	CHARACTER_SORTER_STATE_KEY,
	type ResultData,
} from "~/components/preact/character-sorter/state";
import Icon from "~/components/shared/icon.astro";
import BaseLayout from "~/layouts/base-layout.astro";
import { pages } from "~/lib/page";
import { schema } from "./_params";

const params = Astro.locals.parseQuery(schema);

const characters = (() => {
	if (!params.band && !params.slug) return;
	else if (params.continue || params.slug) return [];

	const results = Object.values(data.characters)
		.filter(({ band }) => params.band!.includes(band.slug))
		.map(({ name, slug }) => {
			const randomCard = sample([...data.cardsByCharacter[slug]]);

			return { name, slug, card: randomCard.slug };
		});

	return shuffle(results);
})();

const override = params.slug
	? await Astro.locals.redis
			.get<ResultData>(`character-sorter:${params.slug}`)
			.catch(null)
	: null;

if (params.slug && !override) return Astro.redirect("/page/character-sorter");
---

<BaseLayout metadata={pages["/page/character-sorter"]}>
	<div class="flex h-full flex-col items-center gap-4">
		<div
			class="inline-flex gap-2"
			hx-replace-url="true"
			hx-select="#sorter"
			hx-swap="outerHTML"
			hx-target="#sorter"
		>
			<button
				hx-get="/page/character-sorter"
				class="tooltip btn tooltip-right btn-circle btn-sm btn-error"
				data-tip="Reset sorter"
				data-umami-event="reset-character-sorter"
				hx-confirm="Start over?"
				hx-on--before-request={`delete localStorage["${CHARACTER_SORTER_STATE_KEY}"]`}
			>
				<IconLoader name="lucide--rotate-ccw" />
			</button>

			<h2 class="badge w-48 badge-xl font-medium badge-accent">
				Character Sorter
			</h2>

			<button
				hx-get="/page/character-sorter"
				class="tooltip btn tooltip-left btn-circle btn-sm btn-warning"
				data-tip="Reload sorter"
				data-umami-event="reload-character-sorter"
			>
				<IconLoader name="lucide--refresh-ccw" />
			</button>
		</div>

		{
			characters ? (
				<div class="contents" id="sorter">
					<CharacterSorter {characters} client:only="preact" {override}>
						<div
							class="relative aspect-4/3 max-sm:w-full sm:h-80"
							slot="fallback"
						>
							<Icon
								class="absolute center size-32 rounded-full bg-accent-content/80 text-accent"
								name="svg-spinners--90-ring-with-bg"
							/>

							<span class="absolute center badge w-max badge-lg font-medium badge-accent">
								loading sorter component...
							</span>
						</div>
					</CharacterSorter>
				</div>
			) : (
				<form class="flex flex-col gap-2 px-8" id="sorter">
					<fieldset
						class="fieldset max-w-lg rounded-box border border-base-300 bg-base-200 p-4 pt-2"
						id="select-band"
					>
						<legend class="fieldset-legend">Bands</legend>

						<div class="flex flex-wrap gap-1">
							{Object.values(data.bands)
								.map(({ name, slug }, idx) => ({
									id: `band_${idx}`,
									value: slug,
									icon: `/assets/bands/${slug}.svg`,
									label: name,
								}))
								.map(({ id, value, label, icon }) => (
									<div data-band={value}>
										<input
											class="peer hidden"
											{id}
											name="band"
											type="checkbox"
											{value}
											checked={!params.band || params.band.includes(value)}
										/>
										<label
											class="btn peer-checked:btn-band peer-disabled:btn-disabled peer-disabled:btn-neutral peer-[&:not(:checked):not(:disabled)]:btn-outline max-sm:btn-sm"
											for={id}
										>
											<img class="size-6" src={icon} alt={`${label} icon`} />
											{label}
										</label>
									</div>
								))}
						</div>
					</fieldset>

					{params.continue === undefined ? (
						<div
							hx-get
							hx-trigger="load"
							class="w-full px-1"
							hx-select="#start-sort"
							hx-swap="outerHTML"
							hx-vals={`js:{ continue: "${CHARACTER_SORTER_STATE_KEY}" in localStorage }`}
						>
							<button class="btn btn-disabled w-full btn-neutral">
								Loading...
							</button>
						</div>
					) : (
						<div
							class="join w-full px-1"
							id="start-sort"
							hx-disabled-elt="#sorter input, #sorter button"
							hx-include="#sorter input"
							hx-select="#sorter"
							hx-swap="outerHTML"
							hx-target="#sorter"
						>
							<button
								hx-get
								class="btn join-item flex-1 btn-neutral"
								data-umami-event="start-character-sorter"
							>
								<IconLoader name="lucide--play" />
								Start sorting
							</button>

							{params.continue && (
								<button
									hx-get
									class="btn join-item btn-info"
									name="continue"
									data-umami-event="continue-character-sorter"
									value="true"
								>
									<IconLoader name="lucide--redo" />
									Continue
								</button>
							)}
						</div>
					)}
				</form>
			)
		}
	</div>
</BaseLayout>
