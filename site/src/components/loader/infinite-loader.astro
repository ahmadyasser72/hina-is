---
import type { JSX } from "astro/jsx-runtime";

import Icon from "../shared/icon.astro";

type Props = { id: string; thing: string } & JSX.HTMLAttributes;

const { id, thing, class: className, ...props } = Astro.props;
---

<div
	{id}
	class:list={["htmx-indicator relative h-32 w-full", className]}
	{...props}
>
	<Icon
		class="absolute center size-32 rounded-full bg-accent-content/80 text-accent"
		name="svg-spinners--90-ring-with-bg"
	/>

	<span class="absolute center badge w-max badge-lg font-medium badge-accent"
		>Loading more {thing}...</span
	>
</div>
