---
import {
	AUDIO_FORMAT,
	IMAGE_FORMAT,
	STAMP_VIDEO_FORMAT,
} from "@hina-is/bestdori/constants";
import type { Bandori } from "@hina-is/bestdori/data";

import type { JSX } from "astro/jsx-runtime";

import IconLoader from "~/components/loader/icon-loader.astro";
import Icon from "./icon.astro";

interface Props extends JSX.HTMLAttributes {
	stamp: Bandori.Stamp;
}

const { stamp, class: className, ...props } = Astro.props;
const id = `stamp-${stamp.slug}`;
---

<div
	{id}
	data-character={stamp.character?.slug}
	class:list={["relative aspect-40/33 h-32", className]}
	{...props}
>
	<img
		class="w-full"
		{...Astro.locals.useThumbhash(`${stamp.slug}-image`)}
		data-floating={`#${id}`}
		src={`/assets/stamps/${stamp.slug}-image.${IMAGE_FORMAT}`}
		alt={`Stamp #${stamp.id}`}
		loading="lazy"
		tabindex="0"
	/>

	<div
		class:list={[
			"floating w-max max-w-48 min-w-32 rounded-field border border-base-content/67 px-1 py-1 sm:px-2",
			stamp.character
				? "bg-character text-character-content"
				: "bg-neutral text-neutral-content",
		]}
		tabindex="-1"
	>
		<div class="flex flex-col items-center">
			{
				typeof stamp.text === "string" ? (
					<p class="text-center text-sm">{stamp.text}</p>
				) : (
					<div class="tooltip text-center text-sm">
						<div
							class="tooltip-content max-w-48"
							set:html={`(${stamp.text.romaji})<br>${stamp.text.japanese}`}
						/>
						{stamp.text.english ?? stamp.text.translate}
					</div>
				)
			}

			<ul class="menu menu-horizontal p-0">
				<li>
					<a
						class="tooltip"
						data-tip="Save image"
						data-umami-event="save-stamp"
						data-umami-event-download="image"
						data-umami-event-stamp={stamp.slug}
						href={`/assets/stamps/${stamp.slug}-image.${IMAGE_FORMAT}`}
						download
					>
						<Icon name="lucide--file-image" />
					</a>
				</li>

				{
					stamp.voiced && (
						<>
							<li>
								<a
									class="tooltip"
									data-tip="Save audio"
									data-umami-event="save-stamp"
									data-umami-event-download="audio"
									data-umami-event-stamp={stamp.slug}
									href={`/assets/stamps/${stamp.slug}-voice.${AUDIO_FORMAT}`}
									download
								>
									<Icon name="lucide--audio-lines" />
								</a>
							</li>
							<li>
								<a
									class="tooltip"
									data-tip="Save video"
									data-umami-event="save-stamp"
									data-umami-event-download="video"
									data-umami-event-stamp={stamp.slug}
									href={`/assets/stamps/${stamp.slug}.${STAMP_VIDEO_FORMAT}`}
									download
								>
									<Icon name="lucide--file-play" />
								</a>
							</li>
						</>
					)
				}

				<li>
					<button
						class="tooltip"
						data-tip="Share stamp"
						data-umami-event="share-stamp"
						data-umami-event-stamp={stamp.slug}
						onclick={`navigator.share({ url: '${new URL(`/embed/stamp/${stamp.slug}`, Astro.site)}' })`}
					>
						<Icon name="lucide--link" />
					</button>
				</li>
			</ul>
		</div>
	</div>

	{
		stamp.voiced && (
			<button
				class="btn absolute right-1 bottom-1.5 btn-circle size-8 border-0 bg-base-100/80 backdrop-blur-sm"
				data-umami-event="play-stamp-audio"
				data-umami-event-stamp={stamp.slug}
				onclick={`playStampAudio(this, '${stamp.slug}')`}
			>
				<IconLoader name="lucide--volume-2" />
			</button>
		)
	}
</div>
