---
import { SITE_NAME } from "astro:env/client";

import { dayjs } from "~/lib/date";
import NavigationMenu from "./navigation-menu.astro";

const BUILD_DATE = dayjs.tz(__BUILD_DATE__);
---

<header
	class="sticky top-0 z-100 border-b border-base-content/5 bg-base-200/67 backdrop-blur-sm"
	id="header"
>
	<div class="navbar container mx-auto">
		<div class="md:navbar-start">
			<label class="btn btn-square btn-ghost md:hidden" for="drawer-menu">
				<iconify-icon class="size-6" icon="lucide:menu" width="none"
				></iconify-icon>
			</label>

			<button
				class="btn btn-square btn-ghost max-md:hidden"
				popovertarget="header-menu"
				style="anchor-name: --anchor-header-menu"
			>
				<iconify-icon class="size-6" icon="lucide:menu" width="none"
				></iconify-icon>
			</button>
		</div>

		<div
			class="navbar-center max-md:navbar-start"
			style="anchor-name: --anchor-header-site"
		>
			<a
				class="btn text-base font-medium btn-ghost btn-sm"
				data-umami-event="header-homepage-link"
				href="/">{SITE_NAME}</a
			>

			<button
				class="btn btn-square btn-ghost btn-sm"
				data-umami-event="header-check-info"
				popovertarget="header-site-dropdown"
			>
				<iconify-icon class="size-4" icon="lucide:info" width="none"
				></iconify-icon>
			</button>
		</div>

		<div class="navbar-end">
			<label
				class="btn swap btn-circle swap-rotate btn-ghost"
				title="Toggle theme"
			>
				<input
					class="theme-controller"
					type="checkbox"
					value="coffee"
					aria-label="Toggle dark theme"
				/>

				<iconify-icon class="swap-off size-6" icon="lucide:sun" width="none"
				></iconify-icon>
				<iconify-icon class="swap-on size-6" icon="lucide:moon" width="none"
				></iconify-icon>
			</label>
		</div>
	</div>
</header>

<NavigationMenu
	class="dropdown mt-2 w-max rounded-box bg-base-200/80 shadow-sm max-md:hidden"
	id="header-menu"
	popover
	style="position-anchor: --anchor-header-menu"
/>

<div
	class="dropdown mt-1 w-max overflow-visible rounded-box bg-base-200 px-4 py-2 shadow-sm md:dropdown-center"
	id="header-site-dropdown"
	popover
	style="position-anchor: --anchor-header-site"
>
	Last updated
	<span
		class="tooltip tooltip-bottom underline decoration-dotted"
		data-tip={BUILD_DATE.format("MM/DD/YYYY hh:mm A")}
	>
		{BUILD_DATE.fromNow()}</span
	>
</div>
